{
  "name": "devspace-fleet-management",
  "main": "../cloud/worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "APP_ORIGIN": "https://fleet-manager.example.invalid",
    "ACCESS_ISSUER": "https://example-team.cloudflareaccess.com",
    "ACCESS_AUD": "SET_TO_THE_MANAGEMENT_ACCESS_APP_AUDIENCE",
    "OWNER_EMAIL": "administrator@example.invalid"
  },
  "d1_databases": [{
    "binding": "TICKETS",
    "database_name": "devspace-fleet-enrollment",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
